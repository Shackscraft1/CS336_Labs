<%- include('partials/header') %>
<section class="profile-box">
    <h1><%= isOwner ? 'Account Settings' : user.username + "'s Profile" %></h1>
    <% if (user.profilePicture) { %><img class="profile-picture mb-3" src="<%= user.profilePicture %>" alt="Profile picture"><% } %>
    <% if (isOwner) { %>
        <% if (error || message) { %><p><%= error || message %></p><% } %>
        <form action="/settings" method="POST" class="simple-box mb-4">
            <label for="username" class="form-label">Username</label>
            <input type="text" id="username" name="username" class="form-control mb-3" value="<%= user.username %>" minlength="3" maxlength="50" required>
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" class="form-control mb-3" value="<%= user.email %>" required>
            <label for="profilePicture" class="form-label">Profile Picture URL (https)</label>
            <input type="url" id="profilePicture" name="profilePicture" class="form-control mb-3" value="<%= user.profilePicture || '' %>">
            <button class="btn btn-primary" type="submit">Save Changes</button>
        </form>
    <% } %>
    <h2 class="h5">Comments</h2>
    <% if (comments.length === 0) { %><p>No comments yet.</p><% } %>
    <% for (let row of comments) { %>
        <div class="simple-box mb-2">
            <p class="mb-2"><a href="/character/<%= row.umaId %>"><%= row.name %></a></p>
            <% if (isOwner) { %>
                <form action="/comments/<%= row.commentId %>/edit" method="POST">
                    <textarea class="form-control mb-2" name="comment" maxlength="1000" required><%= row.comment %></textarea>
                    <button class="btn btn-sm btn-primary" type="submit">Save Comment</button>
                </form>
                <form action="/comments/<%= row.commentId %>/delete" method="POST" class="mt-2">
                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete Comment</button>
                </form>
            <% } else { %>
                <p class="mb-0"><%= row.comment %></p>
            <% } %>
        </div>
    <% } %>
    <h2 class="h5 mt-4">Liked Characters</h2>
    <% if (liked.length === 0) { %><p>No likes yet.</p><% } %>
    <% for (let row of liked) { %><p><a href="/character/<%= row.umaId %>"><%= row.name %></a></p><% } %>
</section>
<%- include('partials/footer') %>