

<%- include('partials/header') %>
<section class="profile-box">
    <h1><%= isOwner ? 'Account Settings' : user.username + "'s Profile" %></h1>
    <% if (user.profilePicture) { %><img class="profile-picture mb-3" src="<%= user.profilePicture %>" alt="Profile picture"><% } %>
    <% if (isOwner) { %>
        <% if (error || message) { %><p><%= error || message %></p><% } %>
        <form action="/settings" method="POST" class="simple-box mb-4">
            <input type="hidden" name="authToken" value="<%= authToken %>">
            <label for="username" class="form-label">Username</label>
            <input type="text" id="username" name="username" class="form-control mb-3" value="<%= user.username %>" minlength="3" maxlength="50" required>
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" class="form-control mb-3" value="<%= user.email %>" required>
            <label for="profilePicture" class="form-label">Profile Picture URL (https)</label>
            <input type="url" id="profilePicture" name="profilePicture" class="form-control mb-3" value="<%= user.profilePicture || '' %>">
            <button class="btn btn-primary" type="submit">Save Changes</button>
        </form>
    <% } %>
    <h2 class="h5">Comments</h2>
    <% if (comments.length === 0) { %><p>No comments yet.</p><% } %>
    <% for (let row of comments) { %>
        <div class="simple-box mb-2">
            <p class="mb-2"><a href="/character/<%= row.umaId %>"><%= row.name %></a></p>
            <% if (isOwner) { %>
                <form action="/comments/<%= row.commentId %>/edit" method="POST">
                    <input type="hidden" name="authToken" value="<%= authToken %>">
                    <textarea class="form-control mb-2" name="comment" maxlength="1000" required><%= row.comment %></textarea>
                    <button class="btn btn-sm btn-primary" type="submit">Save Comment</button>
                </form>
                <form action="/comments/<%= row.commentId %>/delete" method="POST" class="mt-2">
                    <input type="hidden" name="authToken" value="<%= authToken %>">
                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete Comment</button>
                </form>
            <% } else { %>
                <p class="mb-0"><%= row.comment %></p>
            <% } %>
        </div>
    <% } %>
    <h2 class="h5 mt-4">Liked Characters</h2>
    <% if (liked.length === 0) { %><p>No likes yet.</p><% } %>
    <% for (let row of liked) { %><p><a href="/character/<%= row.umaId %>"><%= row.name %></a></p><% } %>
    <% if (isOwner) { %>
        <section class="simple-box mt-4">
            <h2 class="h5">Delete Account</h2>
            <p>Deleting your account will permanently remove your comments and likes.</p>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">Delete Account</button>
        </section>
        <div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="deleteAccountTitle">Are you sure you want to delete your account?</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p>This will permanently delete your account, all your likes, and all your comments. This cannot be undone.</p>
                        <form action="/settings/delete" method="POST">
                            <input type="hidden" name="authToken" value="<%= authToken %>">
                            <label for="deleteConfirmation" class="form-label">Type DELETE to confirm</label>
                            <input type="text" id="deleteConfirmation" name="confirmation" class="form-control mb-3" pattern="DELETE" autocomplete="off" required>
                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger">Permanently Delete Account</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
</section>
<%- include('partials/footer') %>
