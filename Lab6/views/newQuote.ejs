
<%- include('partials/header', {title: 'New Quote'}) %>
<main class="container py-4 flex-grow-1">
    <h1>New Quote</h1>
    <!-- Where you type in the quote -->
    <form action="/insertQuote" method="post" class="col-md-8 col-lg-7">
        <div class="mb-3">
            <label for="quoteInput" class="form-label">Quote</label>
            <input class="form-control" name="quote" id="quoteInput" value="<%= formObject.quote || '' %>">

            <!-- Checks if there is a formErrors object
                 and if it has an entry for the user field  -->
            <% if (formErrors.quote) { %>
                <span class="form-error"><%= formErrors.quote %></span>
            <% } %>
        </div>

        <div class="mb-3">
            <label for="authorInput" class="form-label">Author</label>
            <select class="form-select" name="authorId" id="authorInput">
                <option value="">Select an author</option>
                <% for (let author of formData.authors) { %>
                    <option value="<%= author.authorId %>" <%= formObject.authorId == author.authorId ? 'selected' : '' %>>
                        <%= author.firstName %> <%= author.lastName %>
                    </option>
                <% } %>
            </select>
            <% if (formErrors.authorId) { %>
                <span class="form-error"><%= formErrors.authorId %></span>
            <% } %>
        </div>

        <div class="mb-3">
            <label for="categoryInput" class="form-label">Category</label>
            <select class="form-select" name="category" id="categoryInput">
                <option value="">Select a category</option>
                <% for (let category of formData.categories) { %>
                    <option value="<%= category.category %>" <%= formObject.category == category.category ? 'selected' : '' %>>
                        <%= category.category %>
                    </option>
                <% } %>
            </select>
            <% if (formErrors.category) { %>
                <span class="form-error"><%= formErrors.category %></span>
            <% } %>
        </div>

        <div class="mb-3">
            <label for="likesInput" class="form-label">Likes</label>
            <input class="form-control" type="number" name="likes" id="likesInput" min="0" value="<%= formObject.likes ?? 0 %>">
            <% if (formErrors.likes) { %>
                <span class="form-error"><%= formErrors.likes %></span>
            <% } %>
        </div>

        <button class="btn btn-primary">Create</button>
    </form>
</main>
<%- include('partials/footer') %>
