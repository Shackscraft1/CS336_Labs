
<%- include('partials/header', {title: 'Quotes'}) %>
<main class="container py-4 flex-grow-1">
    <h1>Quotes</h1>
    <p><a href="/newQuote">Add New Quote</a></p>
    <% for (let quote of quotes) { %>
        <div class="item">
            <!-- Creates a link to the editQuote route -->
            <!-- narrowed down to the specific quote Id -->
            <!-- This route renders the edit form -->
            <a href="/editQuote?quoteId=<%= quote.quoteId %>">Update</a>
            "<%= quote.quote %>" -
            <%= quote.firstName %> <%= quote.lastName %> -
            Likes: <%= quote.likes %>
        </div>
    <% } %>
</main>
<%- include('partials/footer') %>
