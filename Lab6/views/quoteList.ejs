
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quotes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Quotes Admin</a>
            <div class="d-flex flex-wrap gap-3">
                <a class="text-white" href="/">Home</a>
                <a class="text-white" href="/newQuote">New Quote</a>
                <a class="text-white" href="/quoteList">Quotes</a>
                <a class="text-white" href="/newAuthor">New Author</a>
                <a class="text-white" href="/authorList">Authors</a>
            </div>
        </div>
    </nav>
    <div class="container my-4">
        <h1>Quotes</h1>
        <p><a class="btn btn-primary" href="/newQuote">Add Quote</a></p>
        <% for (let quote of quotes) { %>
            <div class="border rounded p-3 mb-3">
                <p>"<%= quote.quote %>" - <%= quote.firstName %> <%= quote.lastName %></p>
                <p>Category: <%= quote.category %> | Likes: <%= quote.likes %></p>
                <!-- Creates a link to the editQuote route -->
                <!-- narrowed down to the specific quote Id -->
                <!-- This route renders the edit form -->
                <a class="btn btn-outline-primary btn-sm" href="/editQuote?quoteId=<%= quote.quoteId %>">Update</a>
                <form class="d-inline" action="/deleteQuote" method="post" onsubmit="return confirm('Delete this quote?')">
                    <input type="hidden" name="quoteId" value="<%= quote.quoteId %>">
                    <button class="btn btn-outline-danger btn-sm">Delete</button>
                </form>
            </div>
        <% } %>
    </div>
</body>
</html>
