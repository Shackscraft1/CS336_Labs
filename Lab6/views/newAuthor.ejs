
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Author</title>
</head>
<body>
    <h1>New Author</h1>

    <form action="/insertAuthor" method="post">

        <input name="firstName" placeholder="First Name" value="<%= formObject.firstName || '' %>">
        <% if (formErrors.firstName) { %>
            <span><%= formErrors.firstName %></span>
        <% } %>
        <br><br>

        <input name="lastName" placeholder="Last Name" value="<%= formObject.lastName || '' %>">
        <% if (formErrors.lastName) { %>
            <span><%= formErrors.lastName %></span>
        <% } %>
        <br><br>

        Date of Birth:
        <input type="date" name="dob" value="<%= formObject.dob || '' %>">
        <br><br>

        Date of Death:
        <input type="date" name="dod" value="<%= formObject.dod || '' %>">
        <% if (formErrors.dod) { %>
            <span><%= formErrors.dod %></span>
        <% } %>
        <br><br>

        <input name="gender" placeholder="Gender" value="<%= formObject.gender || '' %>">
        <br><br>
        
        <input name="profession" placeholder="Profession" value="<%= formObject.profession || '' %>">
        <br><br>

        <input name="country" placeholder="Country" value="<%= formObject.country || '' %>">
        <br><br>

        <input name="portrait" placeholder="Portrait URL" value="<%= formObject.portrait || '' %>">
        <br><br>

        <textarea name="biography" placeholder="Biography"><%= formObject.biography || '' %></textarea>
        <br><br>

        <button>Create</button>
    </form>

    <p><a href="/">Home</a></p>
</body>
</html>
