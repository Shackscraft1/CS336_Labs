
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Quote</title>
</head>
<body>
    <h1>Edit Quote</h1>
    <form action="/updateQuote" method="post">
        <input type="hidden" name="quoteId" value="<%= formObject.quoteId %>">

        <label for="quoteInput">Quote</label>
        <input name="quote" id="quoteInput" value="<%= formObject.quote %>">
        <% if (formErrors.quote) { %>
            <span><%= formErrors.quote %></span>
        <% } %>
        <br><br>

        <label for="authorInput">Author</label>
        <select name="authorId" id="authorInput">
            <option value="">Select an author</option>
            <% for (let author of formData.authors) { %>
                <% if (author.authorId == formObject.authorId) { %>
                    <option value="<%= author.authorId %>" selected><%= author.firstName %> <%= author.lastName %></option>
                <% } else { %>
                    <option value="<%= author.authorId %>"><%= author.firstName %> <%= author.lastName %></option>
                <% } %>
            <% } %>
        </select>
        <% if (formErrors.authorId) { %>
            <span><%= formErrors.authorId %></span>
        <% } %>
        <br><br>

        <label for="categoryInput">Category</label>
        <select name="category" id="categoryInput">
            <option value="">Select a category</option>
            <% for (let category of formData.categories) { %>
                <% if (category.category == formObject.category) { %>
                    <option value="<%= category.category %>" selected><%= category.category %></option>
                <% } else { %>
                    <option value="<%= category.category %>"><%= category.category %></option>
                <% } %>
            <% } %>
        </select>
        <% if (formErrors.category) { %>
            <span><%= formErrors.category %></span>
        <% } %>
        <br><br>

        <label for="likesInput">Likes</label>
        <input type="number" name="likes" id="likesInput" min="0" value="<%= formObject.likes ?? 0 %>">
        <% if (formErrors.likes) { %>
            <span><%= formErrors.likes %></span>
        <% } %>
        <br><br>

        <button>Update</button>
    </form>
    <p><a href="/quoteList">Back to Quotes</a></p>
</body>
</html>
