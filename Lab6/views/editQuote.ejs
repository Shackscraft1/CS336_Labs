<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <h1>Edit quote</h1>
    <!-- Where you type in the quote -->
    <form action="/updateQuote" method="post">

        <!-- This keeps track fo the quote Id we're editing so
             we can submit this when we click update -->
        <input type="hidden" name="quoteId" value="<%= formObject.quoteId %>">

        <label for="quoteInput">Quote</label>
        <!-- The "value" being set fills in the text box with the current quote -->
        <input name="quote" id="quoteInput" value="<%= formObject.quote %>">
        
        <!-- Checks if there is a formErrors object 
             and if it has an entry for the user field  -->
        <% if (formErrors.quote) { %>
            <span class="form-error"><%= formErrors.quote %></span> 
        <% } %>

        <label for="authorInput">Author</label>
        <!-- The if statement is to make sure the correct author is selected by default -->
        <select name="authorId" id="authorInput">
            <% for (let author of formData.authors) { %>
                <% if (author.authorId == formObject.authorId) { %>
                    <option value="<%= author.authorId %>" selected><%= author.firstName %></option>
                <% } else { %>
                    <option value="<%= author.authorId %>"><%= author.firstName %></option>
                <% } %>
            <% } %>
        </select>

        <button>Update</button>
    </form>



</body>

</html>