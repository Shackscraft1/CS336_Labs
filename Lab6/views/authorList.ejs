
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Authors</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Quotes Admin</a>
            <div class="d-flex flex-wrap gap-3">
                <a class="text-white" href="/">Home</a>
                <a class="text-white" href="/newQuote">New Quote</a>
                <a class="text-white" href="/quoteList">Quotes</a>
                <a class="text-white" href="/newAuthor">New Author</a>
                <a class="text-white" href="/authorList">Authors</a>
            </div>
        </div>
    </nav>
    <div class="container my-4">
        <h1>Authors</h1>
        <p><a class="btn btn-primary" href="/newAuthor">Add Author</a></p>
        <% for (let author of authors) { %>
            <div class="border rounded p-3 mb-3">
                <h5><%= author.firstName %> <%= author.lastName %></h5>
                <p><%= author.profession || '' %> <%= author.country || '' %></p>
                <a class="btn btn-outline-primary btn-sm" href="/editAuthor?authorId=<%= author.authorId %>">Update</a>
                <form class="d-inline" action="/deleteAuthor" method="post" onsubmit="return confirm('Delete this author and all their quotes?')">
                    <input type="hidden" name="authorId" value="<%= author.authorId %>">
                    <button class="btn btn-outline-danger btn-sm">Delete</button>
                </form>
            </div>
        <% } %>
    </div>
</body>
</html>
